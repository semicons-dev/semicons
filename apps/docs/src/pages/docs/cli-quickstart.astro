---
import '../../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>CLI Quickstart - Semicons</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="logo">Semicons</a>
        <a href="/docs/cli-quickstart">CLI Quickstart</a>
      </nav>
    </header>
    <main>
      <article>
        <h1>CLI Quickstart</h1>
        
        <section>
          <h2>Installation</h2>
          <pre><code>pnpm add @semicons/cli</code></pre>
          <p>Or using npm:</p>
          <pre><code>npm install @semicons/cli</code></pre>
        </section>

        <section>
          <h2>Usage</h2>
          <h3>Init</h3>
          <pre><code>npx @semicons/cli init</code></pre>
          
          <h3>Generate Icons</h3>
          <pre><code>npx @semicons/cli generate</code></pre>
          
          <h3>Scan for Icons</h3>
          <pre><code>npx @semicons/cli scan ./src</code></pre>
          
          <h3>Doctor</h3>
          <pre><code>npx @semicons/cli doctor</code></pre>
        </section>

        <section>
          <h2>Configuration</h2>
          <p>Create a <code>icon-registry.config.ts</code> file:</p>
          <pre><code>import &#123; defineConfig &#125; from '@semicons/cli';

export default defineConfig(&#123;
  outputDir: './src/icons',
  collections: [
    &#123;
      name: 'core',
      source: './icons/*.svg',
    &#125;,
  ],
&#125;);</code></pre>
        </section>
      </article>
    </main>
  </body>
</html>
