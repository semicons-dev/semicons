---
import '../../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" initial-scale="1.0" />
    <title>Playground - Semicons</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/semicons/" class="logo">Semicons</a>
        <a href="/semicons/docs/cli-quickstart">CLI</a>
        <div class="dropdown">
          <a href="/semicons/docs/framework/react-quickstart" class="dropdown-toggle">Framework</a>
          <div class="dropdown-menu">
            <a href="/semicons/docs/framework/react-quickstart">React</a>
            <a href="/semicons/docs/framework/vue-quickstart">Vue</a>
          </div>
        </div>
        <a href="/semicons/docs/playground" style="color: var(--color-primary);">Playground</a>
      </nav>
    </header>
    <main>
      <article>
        <h1>Icon Playground</h1>
        <p>
          Experiment with Semicons in this interactive playground. Select an icon,
          adjust its properties, and see the result in real-time.
        </p>

        <section>
          <h2>Interactive Demo</h2>

          <div class="playground">
            <div class="preview-area">
              <div class="preview-icon" id="previewIcon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M12 8v4M12 16h.01"/>
                </svg>
              </div>
              <div class="preview-info">
                <span id="iconName">navigation:menu</span>
                <span id="iconCategory" class="tag">navigation</span>
              </div>
            </div>

            <div class="controls">
              <div class="control-group">
                <label for="iconSelect">Icon</label>
                <select id="iconSelect">
                  <optgroup label="Navigation">
                    <option value="navigation:menu">navigation:menu</option>
                    <option value="navigation:close">navigation:close</option>
                    <option value="navigation:back">navigation:back</option>
                    <option value="navigation:forward">navigation:forward</option>
                  </optgroup>
                  <optgroup label="Status">
                    <option value="status:info">status:info</option>
                    <option value="status:success">status:success</option>
                    <option value="status:warning">status:warning</option>
                    <option value="status:error">status:error</option>
                  </optgroup>
                  <optgroup label="Action">
                    <option value="action:edit">action:edit</option>
                    <option value="action:delete">action:delete</option>
                    <option value="action:search">action:search</option>
                    <option value="action:share">action:share</option>
                  </optgroup>
                  <optgroup label="Editor">
                    <option value="editor:bold">editor:bold</option>
                    <option value="editor:italic">editor:italic</option>
                    <option value="editor:code">editor:code</option>
                  </optgroup>
                </select>
              </div>

              <div class="control-group">
                <label for="sizeSelect">Size</label>
                <select id="sizeSelect">
                  <option value="xs">Extra Small (12px)</option>
                  <option value="sm">Small (16px)</option>
                  <option value="md" selected>Medium (20px)</option>
                  <option value="lg">Large (24px)</option>
                  <option value="xl">Extra Large (32px)</option>
                  <option value="custom">Custom</option>
                </select>
                <input type="number" id="customSize" value="24" min="8" max="128" style="display: none; margin-top: 0.5rem; padding: 0.5rem; border: 1px solid var(--color-border); border-radius: 4px; width: 100px;">
              </div>

              <div class="control-group">
                <label for="modeSelect">Mode</label>
                <select id="modeSelect">
                  <option value="auto" selected>Auto</option>
                  <option value="inline">Inline</option>
                  <option value="sprite">Sprite</option>
                </select>
              </div>

              <div class="control-group">
                <label>Options</label>
                <div class="checkbox-group">
                  <label>
                    <input type="checkbox" id="decorative" checked>
                    Decorative
                  </label>
                  <label>
                    <input type="checkbox" id="showLabel">
                    Show Label
                  </label>
                </div>
              </div>

              <div class="control-group" id="labelGroup" style="display: none;">
                <label for="ariaLabel">Aria Label</label>
                <input type="text" id="ariaLabel" placeholder="Enter label..." style="padding: 0.5rem; border: 1px solid var(--color-border); border-radius: 4px; width: 100%;">
              </div>
            </div>
          </div>
        </section>

        <section>
          <h2>Generated Code</h2>
          <p>Copy the code below to use this icon in your project:</p>

          <div class="code-output">
            <pre id="codeOutput">&lt;Icon name="navigation:menu" /&gt;</pre>
            <button id="copyButton" class="copy-btn">Copy</button>
          </div>
        </section>

        <section>
          <h2>Icon Tokens</h2>
          <p>
            Semicons uses semantic token names like <code>category:name</code>.
            This abstraction allows you to change the underlying icon without updating your code.
          </p>

          <div class="token-list">
            <div class="token-item">
              <code>navigation:menu</code>
              <span class="token-desc">Main navigation menu icon</span>
            </div>
            <div class="token-item">
              <code>navigation:close</code>
              <span class="token-desc">Close modal or dialog</span>
            </div>
            <div class="token-item">
              <code>status:error</code>
              <span class="token-desc">Error state indicator</span>
            </div>
            <div class="token-item">
              <code>status:success</code>
              <span class="token-desc">Success state indicator</span>
            </div>
            <div class="token-item">
              <code>action:edit</code>
              <span class="token-desc">Edit content action</span>
            </div>
            <div class="token-item">
              <code>action:search</code>
              <span class="token-desc">Search functionality</span>
            </div>
          </div>
        </section>
      </article>
    </main>

    <style>
      .playground {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        border: 1px solid var(--color-border);
        border-radius: 12px;
        overflow: hidden;
        margin: 2rem 0;
      }

      .preview-area {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem;
        background: linear-gradient(135deg, #f5f7ff 0%, #f0f4ff 100%);
        min-height: 300px;
      }

      .preview-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text);
        transition: all 0.2s ease;
      }

      .preview-icon svg {
        transition: all 0.2s ease;
      }

      .preview-info {
        margin-top: 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
      }

      .preview-info #iconName {
        font-family: 'Fira Code', monospace;
        font-size: 0.9rem;
        color: var(--color-text);
      }

      .tag {
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
        background: var(--color-primary);
        color: white;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .controls {
        padding: 1.5rem;
        background: #fafafa;
      }

      .control-group {
        margin-bottom: 1.25rem;
      }

      .control-group label {
        display: block;
        font-weight: 600;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
      }

      .control-group select,
      .control-group input[type="text"],
      .control-group input[type="number"] {
        width: 100%;
        padding: 0.6rem 0.75rem;
        border: 1px solid var(--color-border);
        border-radius: 6px;
        font-size: 0.9rem;
        background: white;
      }

      .control-group select:focus,
      .control-group input:focus {
        outline: none;
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
      }

      .checkbox-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .checkbox-group label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: normal;
        cursor: pointer;
      }

      .checkbox-group input[type="checkbox"] {
        width: 1.1rem;
        height: 1.1rem;
        cursor: pointer;
      }

      .code-output {
        position: relative;
        margin: 1rem 0;
      }

      .code-output pre {
        margin: 0;
        padding: 1.25rem;
        padding-right: 5rem;
        background: #1e1e2e;
        border-radius: 8px;
        overflow-x: auto;
      }

      .copy-btn {
        position: absolute;
        right: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        padding: 0.4rem 0.75rem;
        background: var(--color-primary);
        color: white;
        border: none;
        border-radius: 4px;
        font-size: 0.8rem;
        cursor: pointer;
        transition: background 0.2s;
      }

      .copy-btn:hover {
        background: #4338ca;
      }

      .copy-btn.copied {
        background: #059669;
      }

      .token-list {
        display: grid;
        gap: 0.75rem;
        margin-top: 1.5rem;
      }

      .token-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1rem;
        background: #fafafa;
        border-radius: 6px;
        border: 1px solid var(--color-border);
      }

      .token-item code {
        font-family: 'Fira Code', monospace;
        background: var(--color-primary);
        color: white;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-size: 0.85rem;
      }

      .token-desc {
        color: var(--color-muted);
        font-size: 0.9rem;
      }

      @media (max-width: 768px) {
        .playground {
          grid-template-columns: 1fr;
        }
      }
    </style>

    <script>
      const icons: Record<string, { svg: string; category: string; label: string }> = {
        'navigation:menu': {
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>',
          category: 'navigation',
          label: 'Menu'
        },
        'navigation:close': {
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>',
          category: 'navigation',
          label: 'Close'
        },
        'navigation:back': {
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>',
          category: 'navigation',
          label: 'Back'
        },
        'navigation:forward': {
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>',
          category: 'navigation',
          label: 'Forward'
        },
        'status:info': {
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>',
          category: 'status',
          label: 'Info'
        },
        'status:success': {
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
          category: 'status',
          label: 'Success'
        },
        'status:warning': {
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
          category: 'status',
          label: 'Warning'
        },
        'status:error': {
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>',
          category: 'status',
          label: 'Error'
        },
        'action:edit': {
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>',
          category: 'action',
          label: 'Edit'
        },
        'action:delete': {
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>',
          category: 'action',
          label: 'Delete'
        },
        'action:search': {
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>',
          category: 'action',
          label: 'Search'
        },
        'action:share': {
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>',
          category: 'action',
          label: 'Share'
        },
        'editor:bold': {
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/></svg>',
          category: 'editor',
          label: 'Bold'
        },
        'editor:italic': {
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="4" x2="10" y2="4"/><line x1="14" y1="20" x2="5" y2="20"/><line x1="15" y1="4" x2="9" y2="20"/></svg>',
          category: 'editor',
          label: 'Italic'
        },
        'editor:code': {
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
          category: 'editor',
          label: 'Code'
        }
      };

      const sizeMap: Record<string, number> = {
        xs: 12,
        sm: 16,
        md: 20,
        lg: 24,
        xl: 32
      };

      const previewIcon = document.getElementById('previewIcon') as HTMLElement;
      const iconNameDisplay = document.getElementById('iconName') as HTMLElement;
      const iconCategoryDisplay = document.getElementById('iconCategory') as HTMLElement;
      const iconSelect = document.getElementById('iconSelect') as HTMLSelectElement;
      const sizeSelect = document.getElementById('sizeSelect') as HTMLSelectElement;
      const customSizeInput = document.getElementById('customSize') as HTMLInputElement;
      const modeSelect = document.getElementById('modeSelect') as HTMLSelectElement;
      const decorativeCheckbox = document.getElementById('decorative') as HTMLInputElement;
      const showLabelCheckbox = document.getElementById('showLabel') as HTMLInputElement;
      const labelGroup = document.getElementById('labelGroup') as HTMLElement;
      const ariaLabelInput = document.getElementById('ariaLabel') as HTMLInputElement;
      const codeOutput = document.getElementById('codeOutput') as HTMLElement;
      const copyButton = document.getElementById('copyButton') as HTMLButtonElement;

      function updatePreview() {
        const selectedIcon = iconSelect.value;
        const icon = icons[selectedIcon];

        if (icon) {
          const size = sizeSelect.value === 'custom' ? parseInt(customSizeInput.value) : sizeMap[sizeSelect.value];
          const mode = modeSelect.value;
          const decorative = decorativeCheckbox.checked;
          const showLabel = showLabelCheckbox.checked;
          const ariaLabel = ariaLabelInput.value;

          previewIcon.innerHTML = icon.svg;
          previewIcon.style.width = `${size}px`;
          previewIcon.style.height = `${size}px`;

          const svg = previewIcon.querySelector('svg');
          if (svg) {
            svg.setAttribute('width', `${size}px`);
            svg.setAttribute('height', `${size}px`);
          }

          iconNameDisplay.textContent = selectedIcon;
          iconCategoryDisplay.textContent = icon.category;

          iconCategoryDisplay.className = 'tag';

          labelGroup.style.display = showLabel ? 'block' : 'none';

          updateCode(selectedIcon, size, mode, decorative, ariaLabel);
        }
      }

      function updateCode(name: string, size: number, mode: string, decorative: boolean, ariaLabel: string) {
        let code = `<Icon name="${name}"`;

        if (mode !== 'auto') {
          code += ` mode="${mode}"`;
        }

        if (size !== 20) {
          code += ` size={${size}}`;
        }

        if (!decorative) {
          code += ` :decorative={false}`;
        }

        if (showLabelCheckbox.checked && ariaLabel) {
          code += ` ariaLabel="${ariaLabel}"`;
        }

        code += ' />';
        codeOutput.textContent = code;
      }

      iconSelect.addEventListener('change', updatePreview);
      sizeSelect.addEventListener('change', () => {
        customSizeInput.style.display = sizeSelect.value === 'custom' ? 'block' : 'none';
        updatePreview();
      });
      customSizeInput.addEventListener('input', updatePreview);
      modeSelect.addEventListener('change', updatePreview);
      decorativeCheckbox.addEventListener('change', updatePreview);
      showLabelCheckbox.addEventListener('change', () => {
        labelGroup.style.display = showLabelCheckbox.checked ? 'block' : 'none';
        updatePreview();
      });
      ariaLabelInput.addEventListener('input', updatePreview);

      copyButton.addEventListener('click', () => {
        navigator.clipboard.writeText(codeOutput.textContent || '').then(() => {
          copyButton.textContent = 'Copied!';
          copyButton.classList.add('copied');
          setTimeout(() => {
            copyButton.textContent = 'Copy';
            copyButton.classList.remove('copied');
          }, 2000);
        });
      });

      updatePreview();
    </script>
  </body>
</html>
