---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Semicons - Icon System</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/semicons/" class="logo">Semicons</a>
        <a href="/semicons/docs/cli-quickstart">CLI</a>
        <div class="dropdown">
          <a href="/semicons/docs/framework/react-quickstart" class="dropdown-toggle">Framework</a>
          <div class="dropdown-menu">
            <a href="/semicons/docs/framework/react-quickstart">React</a>
            <a href="/semicons/docs/framework/vue-quickstart">Vue</a>
          </div>
        </div>
      </nav>
    </header>
    <main>
      <section class="hero">
        <h1>Semicons</h1>
        <p>A modern, type-safe icon system for your applications.</p>
        <div class="actions">
          <a href="/semicons/docs/cli-quickstart" class="button primary">Get Started</a>
        </div>
      </section>
      
      <section class="features">
        <div class="feature">
          <h2>Type-Safe</h2>
          <p>Full TypeScript support with generated types for your icons.</p>
        </div>
        <div class="feature">
          <h2>Framework Agnostic</h2>
          <p>Use with React, Vue, or any framework that supports SVG.</p>
        </div>
        <div class="feature">
          <h2>Optimized</h2>
          <p>Automatic tree-shaking and code splitting for minimal bundle size.</p>
        </div>
      </section>
    </main>
  </body>
</html>
