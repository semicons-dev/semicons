{
  "name": "@semicons/eslint-plugin",
  "version": "0.0.1",
  "description": "ESLint plugin for Semicons icon governance - enforce semantic token usage and prevent hardcoded SVGs",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./rules/*": "./dist/rules/*.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^9.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^7.0.0",
    "@typescript-eslint/types": "^7.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.17"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "semicons",
    "icon",
    "svg",
    "lint"
  ],
  "author": "",
  "license": "MIT"
}
